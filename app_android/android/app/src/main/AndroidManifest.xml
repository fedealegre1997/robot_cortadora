<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- BLE para flutter_blue_plus 2.3.15. Fuente: README del paquete, seccion
         "Add permissions for Android (No Location)". El plugin Android
         (flutter_blue_plus_android 9.0.5) deja su manifest vacio a proposito:
         los permisos los declara la app. -->

    <!-- Filtro de Play Store solamente. required="false": la app tambien funciona
         en modo simulado sin BLE, y se instala por fuera de la tienda. -->
    <uses-feature android:name="android.hardware.bluetooth_le" android:required="false" />
    <!-- Sin esto, los permisos BLUETOOTH/BLUETOOTH_ADMIN y *_LOCATION hacen que el
         sistema de build declare como OBLIGATORIAS (implicitas) estas features.
         Solo afecta el filtro de Play Store; se declaran opcionales para expresar
         la intencion: la app funciona sin BLE ni GPS (modo simulado). -->
    <uses-feature android:name="android.hardware.bluetooth" android:required="false" />
    <uses-feature android:name="android.hardware.location" android:required="false" />

    <!-- Android 12+ (API 31+). neverForLocation: la app no deduce ubicacion por BLE
         (no usa androidUsesFineLocation ni beacons), asi que en Android 12+ no se
         pide permiso de ubicacion. -->
    <uses-permission android:name="android.permission.BLUETOOTH_SCAN"
        android:usesPermissionFlags="neverForLocation" />
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />

    <!-- Legado: Android 11 o anterior (API <= 30). El plugin pide FINE_LOCATION
         en runtime para escanear en API <= 30. -->
    <uses-permission android:name="android.permission.BLUETOOTH" android:maxSdkVersion="30" />
    <uses-permission android:name="android.permission.BLUETOOTH_ADMIN" android:maxSdkVersion="30" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" android:maxSdkVersion="30" />

    <!-- Legado: Android 9 o anterior (API <= 28). -->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" android:maxSdkVersion="28" />

    <application
        android:label="Gramanova"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <!-- Specifies an Android theme to apply to this Activity as soon as
                 the Android process has started. This theme is visible to the user
                 while the Flutter UI initializes. After that, this theme continues
                 to determine the Window background behind the Flutter UI. -->
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>
        <!-- Don't delete the meta-data below.
             This is used by the Flutter tool to generate GeneratedPluginRegistrant.java -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
    </application>
    <!-- Required to query activities that can process text, see:
         https://developer.android.com/training/package-visibility and
         https://developer.android.com/reference/android/content/Intent#ACTION_PROCESS_TEXT.

         In particular, this is used by the Flutter engine in io.flutter.plugin.text.ProcessTextPlugin. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>
    </queries>
</manifest>
